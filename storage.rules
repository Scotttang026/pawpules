rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // animal-reports/{caseId}/{0-4}.jpg（一宗案件一個資料夾，最多 5 張）
    match /animal-reports/{caseId}/{fileName} {
      // getDownloadURL() 需要 get 權限；list 禁止，防止有人列出全部相片
      allow get: if true;
      allow list: if false;
      // 只准新建，唔准覆蓋或刪除；前端已統一轉成 JPEG
      allow create: if request.resource.size > 0
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg'
        && caseId.matches('^PW-[A-Z0-9]{1,20}-[A-Z0-9]{1,8}$')
        && fileName.matches('^[0-4][.]jpg$');
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
