rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/adminuser/$(request.auth.uid));
    }

    // 可選字串欄位：唔存在 OK；存在就必須係字串兼唔超過上限
    function optStr(data, key, max) {
      return !(key in data) || (data[key] is string && data[key].size() <= max);
    }

    // 可選 map 欄位：唔存在、null 或 map 都 OK
    function optMapOrNull(data, key) {
      return !(key in data) || data[key] == null || data[key] is map;
    }

    function isValidLocation(loc) {
      return loc is map
        && loc.keys().hasAll(['lat', 'lng', 'address'])
        && loc.keys().hasOnly(['lat', 'lng', 'address', 'district'])
        && loc.lat is number && loc.lat >= -90 && loc.lat <= 90
        && loc.lng is number && loc.lng >= -180 && loc.lng <= 180
        && loc.address is string && loc.address.size() > 0 && loc.address.size() <= 300
        && optStr(loc, 'district', 100);
    }

    // 公開案件文件：hasOnly 白名單，擋走任何多餘欄位（Dirty Dozen #1、#12）
    function isValidCase(caseId, data) {
      return data.keys().hasAll(['id', 'title', 'animalType', 'photoUrl', 'location',
                                 'description', 'status', 'urgency', 'createdAt'])
        && data.keys().hasOnly(['id', 'title', 'animalType', 'customAnimalName', 'photoUrl',
                                'storagePath', 'location', 'description', 'createdAt', 'updatedAt',
                                'status', 'urgency', 'geminiResponse', 'aiAnalysis',
                                'matchedNGOs', 'dispatchedToNGO'])
        && caseId.matches('^[A-Za-z0-9_-]{1,64}$')
        && data.id == caseId
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.animalType in ['cat', 'dog', 'bird', 'other']
        && optStr(data, 'customAnimalName', 100)
        && data.photoUrl is string && data.photoUrl.size() > 0 && data.photoUrl.size() <= 2048
        && optStr(data, 'storagePath', 256)
        && isValidLocation(data.location)
        && data.description is string && data.description.size() > 0 && data.description.size() <= 2000
        && data.status == 'pending'
        && data.urgency in ['P0', 'P1', 'P2']
        && data.createdAt == request.time
        && (!('updatedAt' in data) || data.updatedAt == request.time)
        && optMapOrNull(data, 'aiAnalysis')
        && optMapOrNull(data, 'geminiResponse')
        && (!('matchedNGOs' in data) || data.matchedNGOs == null
            || (data.matchedNGOs is list && data.matchedNGOs.size() <= 3))
        && (!('dispatchedToNGO' in data) || data.dispatchedToNGO == null);
    }

    // 報案人聯絡資料：createdByUid 必須等於真正登入者，唔可以冒認
    function isValidContact(data) {
      return data.keys().hasAll(['reporterName', 'reporterPhone', 'reporterEmail', 'createdByUid', 'createdAt'])
        && data.keys().hasOnly(['reporterName', 'reporterPhone', 'reporterEmail', 'createdByUid', 'createdAt'])
        && data.reporterName is string && data.reporterName.size() <= 100
        && data.reporterPhone is string && data.reporterPhone.size() <= 50
        && data.reporterEmail is string && data.reporterEmail.size() <= 200
        && data.createdAt == request.time
        && ((request.auth == null && data.createdByUid == 'anonymous')
            || (request.auth != null && data.createdByUid == request.auth.uid));
    }

    match /case/{caseId} {
      allow read: if true;
      // 必須同 private/contact 喺同一個 batch 一齊建立
      allow create: if isValidCase(caseId, request.resource.data)
        && existsAfter(/databases/$(database)/documents/case/$(caseId)/private/contact);
      allow update, delete: if isAdmin();

      match /private/{docId} {
        allow read: if isAdmin();
        // 只可以喺「案件同一個 batch 新建」時寫入，唔可以幫舊案件補寫假資料
        allow create: if docId == 'contact'
          && !exists(/databases/$(database)/documents/case/$(caseId))
          && existsAfter(/databases/$(database)/documents/case/$(caseId))
          && isValidContact(request.resource.data);
        allow update, delete: if isAdmin();
      }
    }

    match /ngodatail/{ngoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /adminuser/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
