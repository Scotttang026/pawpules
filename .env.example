pawpulse,dev-pawpulse,test-pawpulse
asia-northeast1
# Google Gemini API Key（傷病分析用）
GEMINI_API_KEY=

# Google Maps Geocoding API Key（地址搜尋用；喺 GCP 建立後填入，留空會停用地址搜尋）
GOOGLE_MAPS_API_KEY=

# Server Port（AI Studio 預設 3000，Docker / Cloud Run 會用 8080）
PORT=3000

GOOGLE_MAPS_SERVER_KEY=
VITE_API_BASE_URL=

# 確認信追蹤連結用嘅正式網址（例如 https://pawpulse-xxxx.a.run.app）
GMAIL_USER=pXXXXXXXXX26@gmail.com
GMAIL_APP_PASSWORD=你嘅16位AppPassword

ADMIN_NOTIFY_EMAIL=ADAMIN@gmail.com


# 每個 instance 每日 AI 分析上限
AI_DAILY_LIMIT=500

FIREBASE_PROJECT_ID=你的 Firebase project ID
FIRESTORE_DATABASE_ID=firebase-applet-config.json 入面 firestoreDatabaseId 嘅值
FIREBASE_STORAGE_BUCKET=你的-bucket.firebasestorage.app

gcloud run services update [服務名稱] --region=[區域] \
  --update-env-vars FIREBASE_PROJECT_ID=xxx,FIRESTORE_DATABASE_ID=xxx,FIREBASE_STORAGE_BUCKET=xxx

gcloud run services describe [服務名稱] --region [區域] --format="yaml(spec.template.spec.containers[0].env)"
gcloud run services update [服務名稱] --region [區域] --update-env-vars "^##^GMAIL_USER=pXXXXXXXXX26@gmail.com##MAIL_FROM_NAME=PawPulse 管理員##ADMIN_NOTIFY_EMAIL=XXXXX@gm
ail.com,XXXX@gmail.com" --update-secrets "GMAIL_APP_PASSWORD=gmail-app-password-key:latest"   

$REGION = "asia-northeast1"
$UAT_URL = "https://pawpulse-uat-302435171171.asia-northeast1.run.app"

gcloud run deploy pawpulse-uat --source . --region $REGION --allow-unauthenticated `
  --set-env-vars "^##^FIREBASE_PROJECT_ID=pawpulseai##FIRESTORE_DATABASE_ID=pawpulse-uat##FIREBASE_STORAGE_BUCKET=pawpulseai.firebasestorage.app##PUBLIC_BASE_URL=$UAT_URL##AI_DAILY_LIMIT=100##GMAIL_USER=pawpulse2026@gmail.com##MAIL_FROM_NAME=PawPulse 管理員 (UAT)##ADMIN_NOTIFY_EMAIL=jeffchan0060@gmail.com" `
  --set-secrets "GOOGLE_MAPS_API_KEY=google-maps-api-key:latest,GEMINI_API_KEY=gemini-api-key:latest,GMAIL_APP_PASSWORD=gmail-app-password-key:latest"

gcloud run services update dev-pawpulse --region=asia-northeast1 --update-env-vars FIREBASE_PROJECT_ID=pawpulseai,FIRESTORE_DATABASE_ID=ai-studio-pawpules-eda4ba81-50a4-4f01-905a-f931c3008e87,FIREBASE_STORAGE_BUCKET=pawpulseai.firebasestorage.app,AI_DAILY_LIMIT=500,PUBLIC_BASE_URL=https://dev-pawpulse-302435171171.asia-northeast1.run.app,GMAIL_USER=pawpulse2026@gmail.com,MAIL_FROM_NAME=PawPulse 管理員,ADMIN_NOTIFY_EMAIL=jeffchan0060@gmail.com,jeffyhosh914@gmail.com,kikiz.saiseirei@gmail.com,scotttang026jp@gmail.com --set-secrets "GOOGLE_MAPS_API_KEY=google-maps-api-key:latest,GEMINI_API_KEY=gemini-api-key:latest,GMAIL_APP_PASSWORD=gmail-app-password-key:latest"

gcloud run services update test-pawpulse --region=asia-northeast1 --update-env-vars "^##^FIREBASE_PROJECT_ID=pawpulseai##FIRESTORE_DATABASE_ID=ai-studio-pawpules-eda4ba81-50a4-4f01-905a-f931c3008e87##FIREBASE_STORAGE_BUCKET=pawpulseai.firebasestorage.app##AI_DAILY_LIMIT=500##PUBLIC_BASE_URL=https://dev-pawpulse-302435171171.asia-northeast1.run.app##GMAIL_USER=pawpulse2026@gmail.com##MAIL_FROM_NAME=PawPulse 管理員##ADMIN_NOTIFY_EMAIL=jeffchan0060@gmail.com,jeffyhosh914@gmail.com,kikiz.saiseirei@gmail.com,scotttang026jp@gmail.com" --set-secrets "GOOGLE_MAPS_API_KEY=google-maps-api-key:latest,GEMINI_API_KEY=gemini-api-key:latest,GMAIL_APP_PASSWORD=gmail-app-password-key:latest"
